# Firebase Configuration for Timely Scripts
# Copy this file to .env and fill in your Firebase project values
# These values come from your Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key

# Shared values between platforms (from lib/config/env.dart)
FIREBASE_PROJECT_ID=PROJECT_ID
FIREBASE_MESSAGING_SENDER_ID=PROJECT_SENDER_ID
FIREBASE_STORAGE_BUCKET=PROJECT_STORAGE_BUCKET

# Firebase Admin SDK Service Account (download JSON from Firebase Console)
# You can either provide the full JSON file path OR individual values below
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
