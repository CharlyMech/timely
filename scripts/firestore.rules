rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Settings collection: employees can read only
    match /settings/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Employees collection: employees can read only
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if false;
    }

    // Roles collection: employees can read only
    match /roles/{roleId} {
      allow read: if true;
      allow write: if false;
    }

    // Employee Statues collection: employees can read only
    match /employee_statuses/{statusId} {
      allow read: if true;
      allow write: if false;
    }

    // Shift Types collection: employees can read only
    match /shift_types/{shiftTypeId} {
      allow read: if true;
      allow write: if false;
    }

    // Shifts collection: employees can read only
    match /shifts/{shiftId} {
      allow read: if true;
      allow write: if false;
    }

    // Time Registrations collection: employees can read and write
    match /time_registrations/{registrationId} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================================
    // AUDIT COLLECTIONS
    // All audit collections allow read and write for traceability
    // ============================================================

    // Login Audit collection: tracks all login attempts
    match /login_audit/{auditId} {
      allow read: if true;
      allow write: if true;
    }

    // Employee Audit collection: tracks employee entity changes
    match /employee_audit/{auditId} {
      allow read: if true;
      allow write: if true;
    }

    // User Audit collection: tracks dashboard user entity changes
    match /user_audit/{auditId} {
      allow read: if true;
      allow write: if true;
    }

    // Shift Type Audit collection: tracks shift type entity changes
    match /shift_type_audit/{auditId} {
      allow read: if true;
      allow write: if true;
    }

    // Shift Audit collection: tracks shift entity changes
    match /shift_audit/{auditId} {
      allow read: if true;
      allow write: if true;
    }

    // Time Registration Audit collection: tracks all time registration actions
    // This is the most critical audit collection
    match /time_registration_audit/{auditId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
